{
  "name": "se-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Utilities for software engineers: security header analyzer, hash and encryption playground, and more. React + Express, deployable on Vercel.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/dev.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "express": "^4.21.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.460.0",
    "node-sql-parser": "^5.4.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
